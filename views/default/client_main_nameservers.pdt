<?php /** @var View $this **/ ?>
    <?php
    $nameservers = (array)($vars->nameservers ?? []);
    $this->Form->create(null, ['id' => 'domain_nameservers']);
    ?>
        <div class="modal-header">
            <h5 class="global_modal_title"><?php $this->_('ClientMain.manage.heading_nameservers');?></h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info"><?php $this->_('ClientMain.manage.text_nameservers_info');?></div>
            <?php
            for ($i = 0; $i < 5; $i++) {
            ?>
            <div class="form-group">
                <?php
                $this->Form->label($this->_('ClientMain.manage.field_nameserver', true, $i + 1), 'nameserver_' . $i);
                $this->Form->fieldText(
                    'nameservers[]',
                    ($nameservers[$i] ?? null),
                    ['id' => 'nameserver_' . $i, 'class' => 'form-control']
                );
                ?>
            </div>
            <?php
            }
            ?>
        </div>
        <div class="modal-footer">
            <?php
            $this->Form->fieldButton('cancel', $this->_('ClientMain.manage.field_modal_cancel', true), ['class' => 'btn btn-light', 'data-dismiss' => 'modal']);
            $this->Form->fieldButton('submit', $this->_('ClientMain.manage.field_submit', true), ['class' => 'btn btn-primary', 'type' => 'submit']);
            ?>
        </div>
    <?php
    $this->Form->end();
    ?>
