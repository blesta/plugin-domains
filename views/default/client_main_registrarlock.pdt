<?php /** @var View $this **/ ?>
    <?php
    $this->Form->create(null, ['id' => 'domain_registrar_lock']);
    ?>
        <div class="modal-header">
            <h5 class="global_modal_title"><?php $this->_('ClientMain.manage.heading_registrar_lock');?></h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info"><?php $this->_('ClientMain.manage.text_registrar_lock_info');?></div>
            <div class="form-group">
                <?php
                $this->Form->label($this->_('ClientMain.manage.field_registrar_lock', true), 'registrar_lock');
                $this->Form->fieldSelect(
                    'registrar_lock',
                    [
                        'on' => $this->_('ClientMain.manage.text_locked', true),
                        'off' => $this->_('ClientMain.manage.text_unlocked', true)
                    ],
                    ($vars->registrar_lock ?? 'off'),
                    ['id' => 'registrar_lock', 'class' => 'form-control']
                );
                ?>
            </div>
        </div>
        <div class="modal-footer">
            <?php
            $this->Form->fieldButton('cancel', $this->_('ClientMain.manage.field_modal_cancel', true), ['class' => 'btn btn-light', 'data-dismiss' => 'modal']);
            $this->Form->fieldButton('submit', $this->_('ClientMain.manage.field_submit', true), ['class' => 'btn btn-primary', 'type' => 'submit']);
            ?>
        </div>
    <?php
    $this->Form->end();
    ?>
