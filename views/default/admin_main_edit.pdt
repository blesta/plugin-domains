                    <?php if (count($module_row_fields ?? []) > 1) { ?>
                    <div class="col-md-6">
                        <?php
                        $this->Form->label(($module_row_name ?? null), 'uncancel_module_row_id', ['class' => 'form-label']);
                        $this->Form->fieldSelect('module_row_id', $module_row_fields ?? [], ($vars->module_row_id ?? null), ['id' => 'uncancel_module_row_id', 'class' => 'form-select']);
                        ?>
                    </div>
                    <?php } ?>
                </div>

                <div class="form-check">
                    <?php
                    $this->Form->fieldCheckbox('notify_order', 'true', ($vars->notify_order ?? 'true') === 'true', ['id' => 'notify_order_uncancel', 'class' => 'form-check-input']);
                    $this->Form->label($this->_('AdminClients.editservice.field_notify_order', true), 'notify_order_uncancel', ['class' => 'form-check-label']);
                    ?>
                </div>
            </div>
            <?php } ?>
