                $this->Form->label($this->_('AdminMain.edit.field_module', true), 'module', ['class' => 'form-label d-flex align-items-center']);
                $this->Form->fieldSelect('module', $modules ?? [], ($vars->module ?? null), ['id' => 'module', 'class' => 'form-select']);
