                <?php $this->Form->label($this->_('AdminClients.editservice.field_new_coupon_code', true), 'coupon_code', ['class' => 'form-label']);?>
                <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.editservice.tooltip_coupon_code');?>"></i>
                <?php $this->Form->fieldText('coupon_code', ($vars->coupon_code ?? null), ['id' => 'coupon_code', 'class' => 'form-control']);?>
            </div>
        </div>

        <div class="package-options">
            <?php
            foreach (($vars->configoptions ?? []) as $option_id => $option_value) {
                $this->Form->fieldHidden('configoptions[' . $option_id . ']', $option_value);
            }
            ?>
        </div>

        <div class="form-check mb-2">
            <?php
            $this->Form->fieldCheckbox('use_module', 'true', ($vars->use_module ?? 'true') == 'true', ['id' => 'use_module_package', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.editservice.field_use_module', true), 'use_module_package', ['class' => 'form-check-label']);
            ?>
        </div>

        <div class="form-check mb-2">
            <?php
            $this->Form->fieldCheckbox('prorate', 'true', ($vars->prorate ?? 'true') == 'true', ['id' => 'prorate_upgrade', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.editservice.field_prorate', true), 'prorate_upgrade', ['class' => 'form-check-label']);
            ?>
            <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.editservice.tooltip_prorate');?>"></i>
        </div>

        <div class="form-check mb-3">
            <?php
            $this->Form->fieldCheckbox('disable_option_logic', 'true', ($vars->disable_option_logic ?? 'true') == 'true', ['id' => 'disable_option_logic', 'class' => 'form-check-input']);
            $this->Form->label($this->_('AdminClients.editservice.field_disable_option_logic', true), 'disable_option_logic', ['class' => 'form-check-label']);
            ?>
            <i class="bi bi-info-circle text-secondary ms-2" data-bs-toggle="tooltip" title="<?php $this->_('AdminClients.editservice.tooltip_disable_option_logic');?>"></i>
        </div>

        <div class="d-flex justify-content-end mb-3" id="service_change_totals"></div>

        <div class="d-flex justify-content-end gap-2">
            <?php
            $this->Form->fieldSubmit('submit', $this->_('AdminMain.edit.field_submit', true), ['class' => 'btn btn-primary']);
            ?>
